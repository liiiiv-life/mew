# /db 데이터베이스 뷰용 Postgres (docker-compose.yml, `npm run db:up`)
MEW_PG_PASSWORD=mew_dev_password
DATABASE_URL=postgres://mew:mew_dev_password@127.0.0.1:55432/mew

# Optional override of the bundled GitHub OAuth App Client ID; blank uses the default.
# Custom apps must enable Device Flow; no client secret needed.
MEW_GITHUB_CLIENT_ID=
