# /db 데이터베이스 뷰용 Postgres (docker-compose.yml, `npm run db:up`)
MEW_PG_PASSWORD=mew_dev_password
DATABASE_URL=postgres://mew:mew_dev_password@127.0.0.1:55432/mew

# 내장 RAG (기본 활성). 첫 의미 검색 때 다국어 q8 모델 약 130MB를 MEW_DATA_DIR에 캐시한다.
MEW_RAG_ENABLED=1
MEW_RAG_MODEL=Xenova/multilingual-e5-small
MEW_RAG_MAX_FILE_BYTES=1000000
