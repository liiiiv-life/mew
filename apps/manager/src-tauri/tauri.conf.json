{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mewnager",
  "version": "0.1.1",
  "identifier": "life.liiiiv.mew.manager",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://localhost:1420", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "mewnager", "width": 1160, "height": 820, "minWidth": 760, "minHeight": 620, "backgroundColor": "#171717" }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
