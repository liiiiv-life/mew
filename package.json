{
  "name": "mew",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "serve": "node server/serve.ts",
    "start": "npm run build && npm run serve",
    "users": "node server/usersCli.ts",
    "lint": "oxlint",
    "build:native": "cd native/collab && cargo build --release && cp target/release/libmew_collab.so mew-collab.node",
    "test": "MEW_DATA_DIR=\"${TMPDIR:-/tmp}/mew-test-data\" node --test 'server/**/*.test.ts' 'packages/**/*.test.ts' 'src/**/*.test.ts'",
    "rag:eval": "node server/rag/evaluate.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "setup": "./mew setup"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.65.0",
    "@agentclientprotocol/codex-acp": "1.6.0",
    "@agentclientprotocol/sdk": "0.14.1",
    "@aws-sdk/client-s3": "^3.1086.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@huggingface/transformers": "3.8.1",
    "@lancedb/lancedb": "0.22.3",
    "@lezer/highlight": "^1.2.3",
    "@lobehub/icons-static-svg": "1.94.0",
    "@mew/editor": "*",
    "@mew/mobile-keys": "*",
    "@mew/shortcuts": "*",
    "@mew/tmux-term": "*",
    "@mew/ui": "*",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "@tiptap/core": "^3.27.4",
    "@tiptap/extension-collaboration": "^3.27.4",
    "@tiptap/extension-collaboration-caret": "^3.27.4",
    "express": "^5.2.1",
    "happy-dom": "^15.11.7",
    "iconoir-react": "^7.11.1",
    "markdown-it": "^14.3.0",
    "multer": "^2.2.0",
    "parse5": "^8.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.13.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simple-git": "^3.36.0",
    "tailwindcss": "^4.3.2",
    "tough-cookie": "^6.0.2",
    "ws": "^8.21.1",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^13.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
